{
  "name": "sipl-debugger",
  "displayName": "SIPL Debugger",
  "description": "Syntax support and Debug Adapter Protocol integration for SIPL",
  "version": "0.1.0",
  "publisher": "sipl-toolkit",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "activationEvents": [
    "onLanguage:sipl",
    "onDebug"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "sipl",
        "aliases": [
          "SIPL",
          "sipl"
        ],
        "extensions": [
          ".sipl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sipl",
        "scopeName": "source.sipl",
        "path": "./syntaxes/sipl.tmLanguage.json"
      }
    ],
    "breakpoints": [
      {
        "language": "sipl"
      }
    ],
    "debuggers": [
      {
        "type": "sipl",
        "label": "SIPL Debugger",
        "languages": [
          "sipl"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the SIPL source file"
              },
              "initialState": {
                "type": "object",
                "default": {}
              },
              "maxSteps": {
                "type": "number",
                "default": 100000
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "sipl",
            "request": "launch",
            "name": "Debug SIPL program",
            "program": "${file}",
            "initialState": {},
            "maxSteps": 100000
          }
        ]
      }
    ],
    "configuration": {
      "title": "SIPL",
      "properties": {
        "sipl.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Python executable with the sipl-toolkit package installed"
        }
      }
    }
  }
}
